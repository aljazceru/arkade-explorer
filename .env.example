# Compatible Arkade REST operator/indexer. Defaults to https://arkade.computer.
# VITE_INDEXER_URL=

# Watched Second on-chain address. Default: BIP341 P2TR derived from its advertised server key.
# Address transactions are not proof of individual rounds or complete network activity.
# VITE_SECOND_SERVER_P2TR=

# Optional verified asset metadata endpoint. Leave unset to disable.
# VITE_VERIFIED_ASSETS_URL=

# Onchain Esplora REST endpoint for the /unilateral-exit executor.
VITE_ESPLORA_URL=https://mempool.space/api

# Observation indexer script: required Ark operator and optional activity source.
# ARK_OBS_ARK_URL=
# ARK_OBS_ACTIVITY_URL=
# Optional Second/Bark operator endpoint; unset to skip that section.
# ARK_OBS_BARK_URL=
# Bitcoin Esplora API used by the observation script.
# ARK_OBS_MEMPOOL_URL=https://mempool.space/api
# Origin header sent to operator endpoints.
# ARK_OBS_ORIGIN=https://ark.observer
# Separate generated observation directory for local Vite dev/preview (not a build input).
# Set this for both the collector and Vite; committed public/observation files are fixtures.
# OBSERVATION_OUT=/tmp/ark-observer-observations

# Live number validation script endpoints.
# ARK_OBS_INDEXER=
# ARK_OBS_ESPLORA=https://mempool.space/api

# Edge middleware OG/meta fetches; unset to serve the neutral ark.observer card.
# OBS_INDEXER=
